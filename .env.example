# Скопируй в .env и заполни. Файл .env в git не попадает.

# Токен Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels)
TUNNEL_TOKEN=
KIBANA_ENCRYPTION_KEY=
# Какой образ запускать. Для локальной сборки эти две строки не нужны.
# На сервере образ берётся из ghcr:
IMAGE=ghcr.io/brokkol/mini-imgur
TAG=latest

# Kibana encryption key (secret, 32+ chars). Generate: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=
